{
  "name": "pronto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A durable GitHub PR review auditor built on Pi Durable.",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pronto": "audit.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types agent.ts",
    "audit": "node --experimental-strip-types audit.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "agent-reviews": "1.1.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
