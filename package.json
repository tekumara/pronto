{
  "name": "pronto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A durable GitHub PR review auditor built on Pi Durable.",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pronto": "audit.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types agent.ts",
    "audit": "node --experimental-strip-types audit.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:replicated": "node test/integration/run-rustfs.mjs",
    "test:protocol": "python3 protocol/check.py && python3 protocol/check_liveness.py",
    "test:protocol:liveness": "python3 protocol/check_liveness.py",
    "test:quint": "mise run quint:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "agent-reviews": "1.3.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
